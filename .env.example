# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
RETRACT_ENVIRONMENT=dev
RETRACT_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_intel
RETRACT_REDIS_URL=redis://redis:6379/0
# Generate your own; the API refuses to start in production with this value.
#   openssl rand -hex 32
RETRACT_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
RETRACT_DATA_DIR=/data

# Rate limiting trusts X-Forwarded-For only from these comma-separated proxy
# CIDRs. The production Compose network is 172.28.0.0/16 and nginx is its only
# proxy to the API; never list a publicly reachable address here.
RETRACT_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# --- Analysis tools ---
# Blank → auto-detect (venv sibling, then PATH). Set explicitly if installed elsewhere.
RETRACT_SEMGREP_PATH=
RETRACT_GITLEAKS_PATH=
RETRACT_SEMGREP_CONFIG=p/default

# Dev-only: allow local:// path URLs (seedy benchmark repo).
RETRACT_ALLOW_LOCAL_REPOS=0

# --- Auth ---
# Dev-only login bypass (no GitHub OAuth needed). Set to 0 in production.
RETRACT_DEV_LOGIN=1
# A dev-login account may analyze one repository per client IP per window. Re-running
# the same repository is allowed. Dev-only convenience, not a security boundary.
RETRACT_DEV_REPO_PER_IP_TTL_SECONDS=86400
RETRACT_FRONTEND_URL=http://localhost:5173
RETRACT_CORS_ORIGINS=http://localhost:5173
# Docker dev host ports. Uncomment or override when 5173/8000/3000 are already
# taken by another project.
# RETRACT_FRONTEND_PORT=5173
# RETRACT_API_PORT=8000
# RETRACT_AGENT_PORT=3000

# GitHub OAuth app (optional when DEV_LOGIN=1)
RETRACT_GITHUB_CLIENT_ID=
RETRACT_GITHUB_CLIENT_SECRET=
RETRACT_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Email (address verification) ---
# Registering sends a verification link, and an account links to a GitHub sign-in
# only once it has followed one — otherwise anyone could pre-register an address and
# claim the account when its owner signed in. Blank means no transport: development
# logs the link (which is how you follow it locally), production logs that it could
# not be sent. Gmail needs 2FA on the account and an "app password".
#   smtps://you%40gmail.com:app-password@smtp.gmail.com:465     (implicit TLS)
#   smtp://you%40gmail.com:app-password@smtp.gmail.com:587      (STARTTLS)
# The address is percent-encoded: `@` must be `%40`.
RETRACT_SMTP_URL=
RETRACT_MAIL_FROM=Retract <no-reply@example.com>

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_intel

# --- eve agent (agent/) ---
# Shared secret the agent presents on API service calls (X-Agent-Token).
#   openssl rand -hex 32
# Blank denies every agent call rather than allowing open access, but production
# requires it, so the agent can reach the API at all.
RETRACT_AGENT_TOKEN=change-me-to-a-random-string
# `mock` runs the deterministic fixture model: no credentials needed, answers come
# from canned transcripts. That is what makes the dev quickstart work offline, and it
# is why this file ships it — do NOT deploy it as-is. The agent refuses to start on
# `mock` when NODE_ENV=production, which docker-compose.prod.yml sets.
# For a real deployment: `gateway` (below, the compose default) or `openai`.
RETRACT_LLM_PROVIDER=mock
# Model id. Defaults per provider: `gpt-5` for `openai`,
# `anthropic/claude-sonnet-4.5` for `gateway`. Leave blank to take the default —
# except when RETRACT_LLM_BASE_URL is set, where the endpoint chooses the ids and a
# blank model is an error (list them at <base-url>/models).
RETRACT_MODEL=
# Optional: re-point the `openai` provider at any OpenAI-compatible endpoint — no
# extra dependency. For opencode-go:
#   RETRACT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
#   RETRACT_LLM_API_MODE=chat
#   RETRACT_LLM_API_KEY=<your opencode-go key>   # or reuse RETRACT_API_KEY
#   RETRACT_MODEL=deepseek-v4.1-flash
# Must be https, except on localhost. The URL and non-secret headers are also
# compiled into the agent image as build args, so changing them requires
# rebuilding the agent — the runtime values must match the build values.
RETRACT_LLM_BASE_URL=
# Which API shape the endpoint speaks: `chat` (/chat/completions, the default, used by
# most compatible gateways including opencode-go) or `responses` (/responses, only
# some). Getting this wrong returns a bare 404.
RETRACT_LLM_API_MODE=chat
# Extra HTTP headers for a custom endpoint, as a JSON object. Some compatible
# gateways demand more than a URL and a key: opencode-go rejects any request
# without `x-opencode-session` ("cannot be routed efficiently") and asks clients
# to identify themselves with their own user agent. A custom endpoint gets a
# default user agent automatically; set this to add or override headers.
#
# Single-quote it in .env — dev-local.sh sources the file with bash, and bare
# {"a":"b"} loses its quotes on the way into the environment.
#   RETRACT_LLM_HEADERS='{"x-opencode-session":"retract-dev"}'
RETRACT_LLM_HEADERS=
# Credential for `openai` only — this is the one variable that provider reads (it falls back
# to OPENAI_API_KEY). When RETRACT_LLM_BASE_URL is set, RETRACT_LLM_API_KEY is preferred.
# Needs a real key; the agent refuses to start on a placeholder.
#   https://platform.openai.com/api-keys
RETRACT_API_KEY=
RETRACT_LLM_API_KEY=
# Credential for `gateway` only, and optional: leave it blank unless
# RETRACT_LLM_PROVIDER=gateway, which refuses to start without it.
#   https://vercel.com/dashboard/ai/api-keys
# The two are not interchangeable — an OpenAI key here is rejected by the gateway,
# and a gateway key in RETRACT_API_KEY is rejected by OpenAI. Both agents error at
# startup naming the variable, rather than failing later on every message.
AI_GATEWAY_API_KEY=

# --- LLM spend controls (per UTC calendar month) ---
# Demo/dev accounts get the demo budget; GitHub/email accounts get the standard
# budget. The deployment cap is enforced across every account, and the provider
# key's own budget is the final hard stop. Set the provider console to the same
# deployment cap.
RETRACT_DEMO_LLM_BUDGET_USD=2
RETRACT_USER_LLM_BUDGET_USD=10
RETRACT_GLOBAL_LLM_BUDGET_USD=2
# Token-price fallback for providers that do not report cost. opencode-go reports
# `list_cost`, but the OpenAI-compatible SDK does not expose that field, so these
# prices are the authoritative cost source. deepseek-v4.1-flash was $0.25/M input
# and output when verified; re-check before relying on the monthly dollar ledger.
RETRACT_LLM_INPUT_COST_PER_MTOK=0.25
RETRACT_LLM_OUTPUT_COST_PER_MTOK=0.25
# Used only when neither provider cost nor token prices are available. Leave blank
# to disable. A demo deployment might use 2000000; a standard one 10000000.
RETRACT_LLM_MONTHLY_TOKEN_BUDGET=

# --- eve agent per-session caps (build-time; rebuild the image to change) ---
# These stop one runaway conversation. The monthly ledger stops the month.
# Demo-only image: 100000 / 20000 / 0.10.
RETRACT_AGENT_MAX_INPUT_TOKENS=200000
RETRACT_AGENT_MAX_OUTPUT_TOKENS=50000
RETRACT_AGENT_MAX_COST_USD=0.50
