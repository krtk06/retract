# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
RETRACT_ENVIRONMENT=dev
RETRACT_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_intel
RETRACT_REDIS_URL=redis://redis:6379/0
# Generate your own; the API refuses to start in production with this value.
#   openssl rand -hex 32
RETRACT_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
RETRACT_DATA_DIR=/data

# --- Analysis tools ---
# Blank → auto-detect (venv sibling, then PATH). Set explicitly if installed elsewhere.
RETRACT_SEMGREP_PATH=
RETRACT_GITLEAKS_PATH=
RETRACT_SEMGREP_CONFIG=p/default

# Dev-only: allow local:// path URLs (seedy benchmark repo).
RETRACT_ALLOW_LOCAL_REPOS=0

# --- Auth ---
# Dev-only login bypass (no GitHub OAuth needed). Set to 0 in production.
RETRACT_DEV_LOGIN=1
RETRACT_FRONTEND_URL=http://localhost:5173
RETRACT_CORS_ORIGINS=http://localhost:5173

# GitHub OAuth app (optional when DEV_LOGIN=1)
RETRACT_GITHUB_CLIENT_ID=
RETRACT_GITHUB_CLIENT_SECRET=
RETRACT_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_intel

# --- eve agent (agent/) ---
# Shared secret the agent presents on API service calls (X-Agent-Token).
#   openssl rand -hex 32
# Blank denies every agent call rather than allowing open access, but production
# requires it, so the agent can reach the API at all.
RETRACT_AGENT_TOKEN=change-me-to-a-random-string
# `mock` runs the deterministic fixture model: no credentials needed, answers come
# from canned transcripts. That is what makes the dev quickstart work offline, and it
# is why this file ships it — do NOT deploy it as-is. The agent refuses to start on
# `mock` when NODE_ENV=production, which docker-compose.prod.yml sets.
# For a real deployment: `gateway` (below, the compose default) or `openai`.
RETRACT_LLM_PROVIDER=mock
# Model id. Defaults per provider: `gpt-5` for `openai`,
# `anthropic/claude-sonnet-4.5` for `gateway`. Leave blank to take the default —
# except when RETRACT_LLM_BASE_URL is set, where the endpoint chooses the ids and a
# blank model is an error (list them at <base-url>/models).
RETRACT_MODEL=
# Optional: re-point the `openai` provider at any OpenAI-compatible endpoint — no
# extra dependency. For opencode-go:
#   RETRACT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
#   RETRACT_LLM_API_MODE=chat
#   RETRACT_LLM_API_KEY=<your opencode-go key>   # or reuse RETRACT_API_KEY
#   RETRACT_MODEL=longcat-2.5-preview-free        # a free opencode-go model
# Must be https, except on localhost. The SDK sends this URL and key per call, so
# neither is baked into the image.
RETRACT_LLM_BASE_URL=
# Which API shape the endpoint speaks: `chat` (/chat/completions, the default, used by
# most compatible gateways including opencode-go) or `responses` (/responses, only
# some). Getting this wrong returns a bare 404.
RETRACT_LLM_API_MODE=chat
# Credential for `openai` only — this is the one variable that provider reads (it falls back
# to OPENAI_API_KEY). When RETRACT_LLM_BASE_URL is set, RETRACT_LLM_API_KEY is preferred.
# Needs a real key; the agent refuses to start on a placeholder.
#   https://platform.openai.com/api-keys
RETRACT_API_KEY=
RETRACT_LLM_API_KEY=
# Credential for `gateway` only, and optional: leave it blank unless
# RETRACT_LLM_PROVIDER=gateway, which refuses to start without it.
#   https://vercel.com/dashboard/ai/api-keys
# The two are not interchangeable — an OpenAI key here is rejected by the gateway,
# and a gateway key in RETRACT_API_KEY is rejected by OpenAI. Both agents error at
# startup naming the variable, rather than failing later on every message.
AI_GATEWAY_API_KEY=
