# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
AI_INTEL_ENVIRONMENT=dev
AI_INTEL_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_intel
AI_INTEL_REDIS_URL=redis://redis:6379/0
# Generate your own; the API refuses to start in production with this value.
#   openssl rand -hex 32
AI_INTEL_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
AI_INTEL_DATA_DIR=/data

# --- Analysis tools ---
# Blank → auto-detect (venv sibling, then PATH). Set explicitly if installed elsewhere.
AI_INTEL_SEMGREP_PATH=
AI_INTEL_GITLEAKS_PATH=
AI_INTEL_SEMGREP_CONFIG=p/default

# Dev-only: allow local:// path URLs (seedy benchmark repo).
AI_INTEL_ALLOW_LOCAL_REPOS=0

# --- Auth ---
# Dev-only login bypass (no GitHub OAuth needed). Set to 0 in production.
AI_INTEL_DEV_LOGIN=1
AI_INTEL_FRONTEND_URL=http://localhost:5173
AI_INTEL_CORS_ORIGINS=http://localhost:5173

# GitHub OAuth app (optional when DEV_LOGIN=1)
AI_INTEL_GITHUB_CLIENT_ID=
AI_INTEL_GITHUB_CLIENT_SECRET=
AI_INTEL_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_intel

# --- eve agent (agent/) ---
# Shared secret the agent presents on API service calls (X-Agent-Token).
#   openssl rand -hex 32
# Blank denies every agent call rather than allowing open access, but production
# requires it, so the agent can reach the API at all.
AI_INTEL_AGENT_TOKEN=change-me-to-a-random-string
# `mock` runs the deterministic fixture model: no credentials needed, answers come
# from canned transcripts. That is what makes the dev quickstart work offline, and it
# is why this file ships it — do NOT deploy it as-is. The agent refuses to start on
# `mock` when NODE_ENV=production, which docker-compose.prod.yml sets.
# For a real deployment: `gateway` (below, the compose default) or `openai`.
AI_INTEL_LLM_PROVIDER=mock
# Only used by `gateway`. Ignored by `openai`, which reads AI_INTEL_API_KEY instead.
AI_INTEL_MODEL=
# Gateway key when calling the AI Gateway from a non-Vercel host. Required by
# docker-compose.prod.yml even when the provider is `mock`, so any value will do.
AI_GATEWAY_API_KEY=
