{
  "name": "retract-agent",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "eval": "RETRACT_LLM_PROVIDER=mock RETRACT_AGENT_TOKEN=eval-agent-service-token eve eval",
    "eval:live": "RETRACT_AGENT_TOKEN=eval-agent-service-token eve eval",
