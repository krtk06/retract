# Machine-specific settings for scripts/dev-local.sh. Copy to .local/env.sh and edit.
# .local/ is gitignored; this example is committed so the shape is discoverable.

# Postgres and Redis the local stack talks to.
export AI_INTEL_DATABASE_URL="postgresql+psycopg://<user>@/ai_intel?host=/var/run/postgresql&port=5433"
export AI_INTEL_REDIS_URL="redis://localhost:6390/0"
export AI_INTEL_DATA_DIR="$PWD/.local/data"

# Dev login instead of GitHub OAuth.
export AI_INTEL_DEV_LOGIN=1
export AI_INTEL_FRONTEND_URL=http://localhost:5175
export AI_INTEL_CORS_ORIGINS=http://localhost:5175

# Must match between backend and agent: the agent verifies the eve token the
# backend mints from the browser session.
export AI_INTEL_JWT_SECRET="local-dev-secret-at-least-32-bytes-long"

# Shared secret for the agent's API service calls.
export AI_INTEL_AGENT_TOKEN="local-dev-agent-token-change-me"

# Deterministic fixture model: no provider credentials needed for local review.
export AI_INTEL_LLM_PROVIDER=mock

# Ports (defaults shown).
export API_PORT=8110
export EVE_PORT=3000
export FRONTEND_PORT=5175
export REDIS_PORT=6390

# Tool binaries, when they are not on PATH.
# export AI_INTEL_SEMGREP_PATH="$HOME/.local/bin/semgrep"
# export AI_INTEL_GITLEAKS_PATH="$HOME/.local/bin/gitleaks"
